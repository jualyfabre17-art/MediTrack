@page "/patients"
@using MediTrack.BlazorWASM.Models
@using MediTrack.BlazorWASM.Services
@inject IPatientService PatientService
@inject NavigationManager Navigation

<h2>Pacientes</h2>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo(" /patients/create")">
        + Nuevo Paciente
    </button>
</div>

@if (patients == null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!patients.Any())
{
    <div class="alert alert-info">
        No hay pacientes registrados. ¡Crea el primero!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Historia Clínica</th>
                    <th>Teléfono</th>
                    <th>Edad</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in patients)
                {
                    <tr>
                        <td>@patient.Id</td>
                        <td>@patient.FullName</td>
                        <td>@patient.IdentificationNumber</td>
                        <td>@patient.MedicalRecordNumber</td>
                        <td>@patient.PhoneNumber</td>
                        <td>@patient.Age</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => Navigation.NavigateTo($" /patients/{patient.Id}")">
                                Ver
                            </button>
                            <button class="btn btn-sm btn-warning" @onclick="() => Navigation.NavigateTo($" /patients/edit/{patient.Id}")">
                                Editar
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePatient(patient.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<PatientModel>? patients;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        patients = await PatientService.GetPatientsAsync();
    }

    private async Task DeletePatient(int id)
    {
        if (await ConfirmDialog("¿Estás seguro de eliminar este paciente?"))
        {
            var success = await PatientService.DeletePatientAsync(id);
            if (success)
            {
                await LoadPatients();
            }
        }
    }

    private async Task<bool> ConfirmDialog(string message)
    {
        return await Task.FromResult(true); // Implementar con JS interop o componente modal
    }
}