@page "/doctors/edit/{id:int}"
@using MediTrack.BlazorWASM.Models
@using MediTrack.BlazorWASM.Services
@inject IDoctorService DoctorService
@inject NavigationManager Navigation

<div class="container my-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-pencil-square text-warning me-2"></i>Editar Doctor
        </h2>
        <p class="text-muted">Actualiza la información del profesional de la salud.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    @if (doctor == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2">Cargando datos del doctor...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <EditForm Model="@doctor" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <h5 class="mb-3">Datos Personales</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="firstName" class="form-label fw-semibold">Nombre</label>
                                <InputText id="firstName" class="form-control" @bind-Value="doctor.FirstName" />
                                <ValidationMessage For="@(() => doctor.FirstName)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="lastName" class="form-label fw-semibold">Apellido</label>
                                <InputText id="lastName" class="form-control" @bind-Value="doctor.LastName" />
                                <ValidationMessage For="@(() => doctor.LastName)" class="text-danger" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
                                <InputText id="email" class="form-control" @bind-Value="doctor.Email" />
                                <ValidationMessage For="@(() => doctor.Email)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="phone" class="form-label fw-semibold">Teléfono</label>
                                <InputText id="phone" class="form-control" @bind-Value="doctor.PhoneNumber" />
                                <ValidationMessage For="@(() => doctor.PhoneNumber)" class="text-danger" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="birthdate" class="form-label fw-semibold">Fecha de Nacimiento</label>
                                <InputDate id="birthdate" class="form-control" @bind-Value="doctor.DateOfBirth" />
                                <ValidationMessage For="@(() => doctor.DateOfBirth)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="gender" class="form-label fw-semibold">Género</label>
                                <InputSelect id="gender" class="form-select" @bind-Value="doctor.Gender">
                                    <option value="">Seleccionar...</option>
                                    <option value="Male">Masculino</option>
                                    <option value="Female">Femenino</option>
                                    <option value="Other">Otro</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => doctor.Gender)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="license" class="form-label fw-semibold">Número de Licencia</label>
                                <InputText id="license" class="form-control" @bind-Value="doctor.LicenseNumber" />
                                <ValidationMessage For="@(() => doctor.LicenseNumber)" class="text-danger" />
                            </div>
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3">Datos Profesionales</h5>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="experience" class="form-label fw-semibold">Años de Experiencia</label>
                                <InputNumber id="experience" class="form-control" @bind-Value="doctor.YearsOfExperience" />
                                <ValidationMessage For="@(() => doctor.YearsOfExperience)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="fee" class="form-label fw-semibold">Honorario (RD$)</label>
                                <InputNumber id="fee" class="form-control" @bind-Value="doctor.ConsultationFee" />
                                <ValidationMessage For="@(() => doctor.ConsultationFee)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="startTime" class="form-label fw-semibold">Hora Inicio</label>
                                <InputText id="startTime" class="form-control" @bind-Value="doctor.StartTime" />
                                <ValidationMessage For="@(() => doctor.StartTime)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label for="endTime" class="form-label fw-semibold">Hora Fin</label>
                                <InputText id="endTime" class="form-control" @bind-Value="doctor.EndTime" />
                                <ValidationMessage For="@(() => doctor.EndTime)" class="text-danger" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="departmentId" class="form-label fw-semibold">ID del Departamento</label>
                                <InputNumber id="departmentId" class="form-control" @bind-Value="doctor.DepartmentId" />
                                <ValidationMessage For="@(() => doctor.DepartmentId)" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="specialtyId" class="form-label fw-semibold">ID de la Especialidad</label>
                                <InputNumber id="specialtyId" class="form-control" @bind-Value="doctor.SpecialtyId" />
                                <ValidationMessage For="@(() => doctor.SpecialtyId)" class="text-danger" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="officeLocation" class="form-label fw-semibold">Ubicación del Consultorio</label>
                        <InputText id="officeLocation" class="form-control" @bind-Value="doctor.OfficeLocation" />
                    </div>

                    <h5 class="mt-4 mb-3">Dirección de Residencia</h5>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="street" class="form-label fw-semibold">Calle / Avenida y Número</label>
                                <InputText id="street" class="form-control" @bind-Value="doctor.Address.Street" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="city" class="form-label fw-semibold">Ciudad</label>
                                <InputText id="city" class="form-control" @bind-Value="doctor.Address.City" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="state" class="form-label fw-semibold">Estado o Provincia</label>
                                <InputText id="state" class="form-control" @bind-Value="doctor.Address.State" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="postalCode" class="form-label fw-semibold">Código Postal</label>
                                <InputText id="postalCode" class="form-control" @bind-Value="doctor.Address.PostalCode" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="country" class="form-label fw-semibold">País</label>
                                <InputText id="country" class="form-control" @bind-Value="doctor.Address.Country" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark px-4 py-2" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Guardar Cambios
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private DoctorUpdateModel? doctor;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await DoctorService.GetDoctorAsync(Id);
            if (data == null)
            {
                Navigation.NavigateTo("/doctors");
                return;
            }

            doctor = new DoctorUpdateModel
            {
                Id = data.Id,
                FirstName = data.FirstName,
                LastName = data.LastName,
                Email = data.Email,
                PhoneNumber = data.PhoneNumber,
                DateOfBirth = data.DateOfBirth,
                Gender = data.Gender,
                LicenseNumber = data.LicenseNumber,
                YearsOfExperience = data.YearsOfExperience,
                OfficeLocation = data.OfficeLocation,
                ConsultationFee = data.ConsultationFee,
                StartTime = data.StartTime,
                EndTime = data.EndTime,
                DepartmentId = 0, 
                SpecialtyId = 0,   
                Address = data.Address ?? new AddressModel()
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos: {ex.Message}";
            Console.WriteLine($"ERROR en Edit doctor: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/doctors");
    }

    private async Task HandleValidSubmit()
    {
        if (doctor == null) return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var success = await DoctorService.UpdateDoctorAsync(doctor);
            if (success)
            {
                Navigation.NavigateTo("/doctors");
            }
            else
            {
                errorMessage = "Error al actualizar el doctor. Verifica los datos e intenta de nuevo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"ERROR en Update doctor: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
