@page "/"
@using MediTrack.BlazorWASM.v2.Models
@using MediTrack.BlazorWASM.v2.Services
@inject IPatientService PatientService
@inject IAppointmentService AppointmentService
@inject IDoctorService DoctorService
@inject NavigationManager Navigation

<div class="container-fluid my-4 px-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Panel de Control
        </h2>
        <p class="text-muted mb-0">Bienvenido a MediTrack. Visualiza de un vistazo las estadísticas clave de hoy y accede a las acciones rápidas.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3" style="background: linear-gradient(135deg, #0d6efd, #0a58ca); color: white;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase fw-semibold font-monospace fs-8 d-block mb-1">Total Pacientes</span>
                        <h3 class="display-5 fw-bold mb-0">@totalPatients</h3>
                    </div>
                    <div class="bg-white-10 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: rgba(255,255,255,0.15);">
                        <i class="bi bi-people-fill fs-3 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3" style="background: linear-gradient(135deg, #198754, #146c43); color: white;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase fw-semibold font-monospace fs-8 d-block mb-1">Citas de Hoy</span>
                        <h3 class="display-5 fw-bold mb-0">@todayAppointments</h3>
                    </div>
                    <div class="bg-white-10 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: rgba(255,255,255,0.15);">
                        <i class="bi bi-calendar-check-fill fs-3 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3" style="background: linear-gradient(135deg, #ffc107, #ca9300); color: white;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-dark-50 text-uppercase fw-semibold font-monospace fs-8 d-block mb-1" style="color: rgba(0,0,0,0.5);">Citas Pendientes</span>
                        <h3 class="display-5 fw-bold mb-0 text-dark">@pendingAppointments</h3>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: rgba(0,0,0,0.08);">
                        <i class="bi bi-calendar-event-fill fs-3 text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3" style="background: linear-gradient(135deg, #0dcaf0, #0aa2c0); color: white;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase fw-semibold font-monospace fs-8 d-block mb-1">Doctores Activos</span>
                        <h3 class="display-5 fw-bold mb-0">@activeDoctors</h3>
                    </div>
                    <div class="bg-white-10 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: rgba(255,255,255,0.15);">
                        <i class="bi bi-heart-pulse-fill fs-3 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Acciones Rápidas
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <button class="btn btn-primary btn-lg py-3 px-4 d-flex align-items-center justify-content-between rounded-3 border-0 shadow-xs" @onclick="IrACrearPaciente" style="background-color: #0d6efd;">
                            <span class="d-flex align-items-center gap-2 fw-semibold">
                                <i class="bi bi-person-plus-fill fs-4"></i>Registrar Nuevo Paciente
                            </span>
                            <i class="bi bi-chevron-right fs-5"></i>
                        </button>
                        <button class="btn btn-success btn-lg py-3 px-4 d-flex align-items-center justify-content-between rounded-3 border-0 shadow-xs" @onclick="IrACrearCita" style="background-color: #198754;">
                            <span class="d-flex align-items-center gap-2 fw-semibold">
                                <i class="bi bi-calendar-plus-fill fs-4"></i>Agendar Nueva Cita Médica
                            </span>
                            <i class="bi bi-chevron-right fs-5"></i>
                        </button>
                        <button class="btn btn-info btn-lg py-3 px-4 d-flex align-items-center justify-content-between text-white rounded-3 border-0 shadow-xs" @onclick="IrAListadoPacientes" style="background-color: #0dcaf0;">
                            <span class="d-flex align-items-center gap-2 fw-semibold">
                                <i class="bi bi-journal-medical fs-4"></i>Ver Directorio de Pacientes
                            </span>
                            <i class="bi bi-chevron-right fs-5 text-white"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-history text-primary me-1"></i>Últimos Pacientes Registrados
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (recentPatients == null)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary mb-2 spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <small class="text-muted">Cargando historial reciente...</small>
                        </div>
                    }
                    else if (!recentPatients.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-folder-x text-muted" style="font-size: 2.5rem;"></i>
                            <p class="text-muted mt-2 mb-0">No se encontraron pacientes registrados recientemente.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var patient in recentPatients.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-3 border-bottom-light" @onclick="() => VerDetallesPaciente(patient.Id)" style="cursor: pointer;">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            @patient.FirstName[0]@patient.LastName[0]
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@patient.FullName</span>
                                            <small class="text-muted fs-8">ID: #@patient.Id</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-primary border rounded-pill font-monospace py-1.5 px-2.5">
                                        @patient.MedicalRecordNumber
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalPatients = 0;
    private int todayAppointments = 0;
    private int pendingAppointments = 0;
    private int activeDoctors = 0;
    private List<PatientModel>? recentPatients;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el panel: {ex.Message}";
            Console.WriteLine($"ERROR en Dashboard: {ex.Message}");
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var patients = await PatientService.GetPatientsAsync();
            totalPatients = patients.Count;
            recentPatients = patients.OrderByDescending(p => p.CreatedAt).Take(5).ToList();
        }
        catch (Exception ex)
        {
            throw new Exception($"Error al obtener pacientes: {ex.Message}", ex);
        }

        // Datos simulados (después puedes reemplazar con datos reales)
        todayAppointments = 8;
        pendingAppointments = 12;
        activeDoctors = 15;
    }

    private void IrACrearPaciente() => Navigation.NavigateTo("/patients/create");
    private void IrACrearCita() => Navigation.NavigateTo("/appointments/create");
    private void IrAListadoPacientes() => Navigation.NavigateTo("/patients");
    private void VerDetallesPaciente(int id) => Navigation.NavigateTo($"/patients/{id}");
}
