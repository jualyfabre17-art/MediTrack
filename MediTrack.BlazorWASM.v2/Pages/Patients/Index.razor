@page "/patients"
@using MediTrack.BlazorWASM.v2.Models
@using MediTrack.BlazorWASM.v2.Services
@inject IPatientService PatientService
@inject NavigationManager Navigation

<div class="container my-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-person-fill text-primary me-2"></i>Pacientes
            </h2>
            <p class="text-muted mb-0">Gestione el expediente clínico de todos los pacientes registrados.</p>
        </div>
        <div>
            <button class="btn btn-primary px-4 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="IrANuevoPaciente">
                <i class="bi bi-person-plus fs-5"></i>
                <span>Nuevo Paciente</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (patients == null)
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <span class="text-muted">Obteniendo listado de pacientes...</span>
                </div>
            }
            else if (!patients.Any())
            {
                <div class="p-5 text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-x text-muted" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="fw-semibold">No hay pacientes registrados</h5>
                    <p class="text-muted mx-auto" style="max-width: 400px;">
                        No se encontraron pacientes en el sistema. ¡Registra el primer paciente ahora!
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-4" style="width: 80px;">ID</th>
                                <th>Nombre</th>
                                <th>Identificación</th>
                                <th>Historia Clínica</th>
                                <th>Teléfono</th>
                                <th>Edad</th>
                                <th class="text-end pe-4" style="width: 220px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in patients)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">#@patient.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                                @patient.FirstName[0]@patient.LastName[0]
                                            </div>
                                            <span class="fw-semibold text-dark">@patient.FullName</span>
                                        </div>
                                    </td>
                                    <td>@patient.IdentificationNumber</td>
                                    <td><span class="badge bg-light text-primary border font-monospace py-1.5 px-2.5">@patient.MedicalRecordNumber</span></td>
                                    <td>@patient.PhoneNumber</td>
                                    <td>@patient.Age</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 px-2" @onclick="() => VerDetalle(patient.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 px-2" @onclick="() => Editar(patient.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-2" @onclick="() => Eliminar(patient.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PatientModel>? patients;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        try
        {
            patients = await PatientService.GetPatientsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar pacientes: {ex.Message}";
            Console.WriteLine($"ERROR en Index pacientes: {ex.Message}");
        }
    }

    private void IrANuevoPaciente() => Navigation.NavigateTo("/patients/create");
    private void VerDetalle(int id) => Navigation.NavigateTo($"/patients/{id}");
    private void Editar(int id) => Navigation.NavigateTo($"/patients/edit/{id}");

    private async Task Eliminar(int id)
    {
        if (await ConfirmDialog())
        {
            var success = await PatientService.DeletePatientAsync(id);
            if (success)
            {
                await LoadPatients();
            }
            else
            {
                errorMessage = "Error al eliminar el paciente. Intente de nuevo.";
            }
        }
    }

    private async Task<bool> ConfirmDialog()
    {
        // Placeholder: en producción usar JS interop o componente modal
        return await Task.FromResult(true);
    }
}
