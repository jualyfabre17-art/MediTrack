@page "/patients"
@using MediTrack.Web.V2.Models
@using MediTrack.Web.V2.Services
@inject ApiService Api

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill text-primary"></i> Gestión de Pacientes</h2>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-person-plus-fill"></i> Nuevo Paciente
        </button>
    </div>

    <!-- Buscador Integrado -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Buscar por nombre o identificación..." @bind="searchTerm" />
                <button class="btn btn-outline-secondary" @onclick="SearchPatients"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </div>
    </div>

    <!-- Alertas de Estado -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Tabla de Pacientes -->
    @if (patientsList == null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando pacientes...</span>
            </div>
        </div>
    }
    else if (!patientsList.Any())
    {
        <div class="alert alert-warning text-center">No se encontraron pacientes registrados.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white m-0">
                <thead class="table-dark">
                    <tr>
                        <th>Récord</th>
                        <th>Nombre Completo</th>
                        <th>Identificación</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Edad</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in patientsList)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@patient.MedicalRecordNumber</span></td>
                            <td><strong>@patient.FullName</strong></td>
                            <td>@patient.IdentificationNumber</td>
                            <td>@patient.Email</td>
                            <td>@patient.PhoneNumber</td>
                            <td>@patient.Age años</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => OpenEditModal(patient)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePatient(patient.Id)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ======================================================== -->
<!-- MODAL DE FORMULARIO BLINDADO CONTRA BAD REQUESTS -->
<!-- ======================================================== -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(isEditMode ? "Modificar Paciente" : "Registrar Nuevo Paciente")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <!-- EditForm maneja la validación de manera nativa e impide envíos corruptos -->
                    <EditForm Model="patientModel" OnValidSubmit="HandleSave">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="patientModel.FirstName" />
                                <ValidationMessage For="@(() => patientModel.FirstName)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="patientModel.LastName" />
                                <ValidationMessage For="@(() => patientModel.LastName)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Número de Identificación (Cédula)</label>
                                <InputText class="form-control" @bind-Value="patientModel.IdentificationNumber" />
                                <ValidationMessage For="@(() => patientModel.IdentificationNumber)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de Nacimiento</label>
                                <InputDate class="form-control" @bind-Value="patientModel.DateOfBirth" />
                                <ValidationMessage For="@(() => patientModel.DateOfBirth)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Correo Electrónico</label>
                                <InputText type="email" class="form-control" @bind-Value="patientModel.Email" />
                                <ValidationMessage For="@(() => patientModel.Email)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="patientModel.PhoneNumber" />
                                <ValidationMessage For="@(() => patientModel.PhoneNumber)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Género</label>
                                <InputSelect class="form-select" @bind-Value="patientModel.Gender">
                                    <option value="">Seleccione...</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Femenino">Femenino</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => patientModel.Gender)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo de Sangre</label>
                                <InputSelect class="form-select" @bind-Value="patientModel.BloodType">
                                    <option value="0">O Positive (O+)</option>
                                    <option value="1">O Negative (O-)</option>
                                    <option value="2">A Positive (A+)</option>
                                    <option value="3">A Negative (A-)</option>
                                    <option value="4">B Positive (B+)</option>
                                    <option value="5">B Negative (B-)</option>
                                    <option value="6">AB Positive (AB+)</option>
                                    <option value="7">AB Negative (AB-)</option>
                                </InputSelect>
                            </div>
                        </div>

                        <h5 class="mt-4 border-bottom pb-2 text-secondary"><i class="bi bi-geo-alt-fill"></i> Dirección de Residencia</h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Calle y Número</label>
                                <InputText class="form-control" @bind-Value="patientModel.Address.Street" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ciudad</label>
                                <InputText class="form-control" @bind-Value="patientModel.Address.City" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Provincia / Estado</label>
                                <InputText class="form-control" @bind-Value="patientModel.Address.State" />
                            </div>
                        </div>

                        <div class="modal-footer mt-4 px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save2-fill"></i> Guardar Paciente
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PatientResponseDto>? patientsList;
    private PatientUpdateDto patientModel = new();
    private string searchTerm = string.Empty;
    private string? statusMessage;
    private bool showModal = false;
    private bool isEditMode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        var result = await Api.GetAsync<List<PatientResponseDto>>("api/patients");
        if (result.IsSuccess)
        {
            patientsList = result.Data;
        }
        else
        {
            statusMessage = $"Error: {result.Message}";
        }
    }

    private async Task SearchPatients()
    {
        var result = await Api.GetAsync<List<PatientResponseDto>>($"api/patients/search?searchTerm={searchTerm}");
        if (result.IsSuccess) patientsList = result.Data;
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        patientModel = new PatientUpdateDto { DateOfBirth = DateTime.Today.AddYears(-20) };
        showModal = true;
    }

    private void OpenEditModal(PatientResponseDto patient)
    {
        isEditMode = true;
        patientModel = new PatientUpdateDto
        {
            Id = patient.Id,
            FirstName = patient.FirstName,
            LastName = patient.LastName,
            Email = patient.Email,
            PhoneNumber = patient.PhoneNumber,
            DateOfBirth = patient.DateOfBirth,
            Gender = patient.Gender,
            IdentificationNumber = patient.IdentificationNumber,
            BloodType = 0, // Mapeado por defecto temporalmente
            Address = new AddressDto
            {
                Street = patient.Address.Street,
                City = patient.Address.City,
                State = patient.Address.State,
                PostalCode = patient.Address.PostalCode,
                Country = patient.Address.Country
            }
        };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSave()
    {
        if (isEditMode)
        {
            var result = await Api.PutAsync<PatientUpdateDto, PatientResponseDto>($"api/patients/{patientModel.Id}", patientModel);
            if (result.IsSuccess) statusMessage = "Paciente modificado correctamente.";
            else statusMessage = $"Error al actualizar: {string.Join(", ", result.Errors)} {result.Message}";
        }
        else
        {
            // Convertimos el Dto de actualización al de creación removiendo el ID interno
            var createDto = new PatientCreateDto
            {
                FirstName = patientModel.FirstName,
                LastName = patientModel.LastName,
                Email = patientModel.Email,
                PhoneNumber = patientModel.PhoneNumber,
                DateOfBirth = patientModel.DateOfBirth,
                Gender = patientModel.Gender,
                IdentificationNumber = patientModel.IdentificationNumber,
                BloodType = patientModel.BloodType,
                Address = patientModel.Address
            };
            var result = await Api.PostAsync<PatientCreateDto, PatientResponseDto>("api/patients", createDto);
            if (result.IsSuccess) statusMessage = "Paciente registrado de manera exitosa.";
            else statusMessage = $"Error al crear: {string.Join(", ", result.Errors)} {result.Message}";
        }

        showModal = false;
        await LoadPatients();
    }

    private async Task DeletePatient(int id)
    {
        var result = await Api.DeleteAsync($"api/patients/{id}");
        if (result.IsSuccess)
        {
            statusMessage = "Paciente eliminado (inactivado) con éxito.";
            await LoadPatients();
        }
    }
}
